# Server-only provider credential. Never prefix with NEXT_PUBLIC_.
NEAR_INTENTS_JWT=

# Supabase project connection. The publishable key is designed for browser use with RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase secret key. Required for trusted checkout writes and settlement updates.
# Never expose this to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Optional: public-facing application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
